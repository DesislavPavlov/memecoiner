# Required only for PumpPortal's FREE discovery streams
# (new-token + migration). Do not put wallet private keys here.
PUMPPORTAL_API_KEY=

# Free Solana mainnet WebSocket. No API key required.
# You can later replace this with a free-tier RPC provider endpoint.
SOLANA_WS_URL=wss://api.mainnet.solana.com/

# Stage-1 watch limits so the free public RPC is not abused.
CURVE_WATCH_TTL_MS=180000
MAX_CURVE_SUBSCRIPTIONS=100

# Optional overrides.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
EVENT_LOG_PATH=data/events.jsonl
LOG_LEVEL=info
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000
