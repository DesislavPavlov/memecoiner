# PumpPortal FREE discovery streams only (new-token + migration).
# Never put a wallet private key in this project.
PUMPPORTAL_API_KEY=

# Free Solana mainnet WebSocket. No API key required.
SOLANA_WS_URL=wss://api.mainnet.solana.com/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Free RPC watch limits.
CURVE_WATCH_TTL_MS=180000
MAX_CURVE_SUBSCRIPTIONS=100
PUMPSWAP_WATCH_TTL_MS=300000
MAX_PUMPSWAP_SUBSCRIPTIONS=40

# Local dashboard / paper accounts.
DASHBOARD_PORT=3210
PAPER_STARTING_BALANCE_SOL=10
PAPER_POSITION_SOL=0.25
PAPER_FEE_PCT_PER_SIDE=1.25
PAPER_MIGRATION_ENTRY_WINDOW_SEC=120
PAPER_MIGRATION_MIN_DIP_PCT=8
PAPER_MIGRATION_RECOVERY_PCT=3
PAPER_HYBRID_RECOVERY_PCT=4
PAPER_HYBRID_MIN_SCORE=75
PAPER_JOURNAL_PATH=data/paper-trades.jsonl

# Optional overrides.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
EVENT_LOG_PATH=data/events.jsonl
LOG_LEVEL=info
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=30000
